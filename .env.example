# ── Lyzr SDK ─────────────────────────────────────────────────────────
LYZR_AGENT_API_KEY="your-lyzr-api-key"
LYZR_EXTRACTION_AGENT_ID="your-extraction-agent-id"
LYZR_RAG_AGENT_ID="your-rag-agent-id"

# ── Qdrant ───────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME=org_memory
QDRANT_GRPC_PORT=6334
QDRANT_PREFER_GRPC=true

# ── PostgreSQL ───────────────────────────────────────────────────────
POSTGRES_USER=chiefofstaff
POSTGRES_PASSWORD=chiefofstaff
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=org_memory

# ── Embeddings ───────────────────────────────────────────────────────
EMBED_MODEL_NAME=all-MiniLM-L6-v2
EMBED_DIM=384

# ── Auth / OAuth (Phase 5) ──────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ── App ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
