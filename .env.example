# Supply real values through a local secret store or deployment secret manager.
LYZR_AGENT_API_KEY=
LYZR_EXTRACTION_AGENT_ID=
LYZR_RAG_AGENT_ID=

POSTGRES_USER=chiefofstaff
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=org_memory
# Railway: set POSTGRES_URL to its managed Postgres DATABASE_URL instead.
POSTGRES_URL=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_APPLICATION_CREDENTIALS=
# Railway: paste the entire service-account JSON as one secret variable.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
PUBSUB_WEBHOOK_TOKEN=replace-with-a-random-shared-secret

# Configure this in production to export traces to Phoenix, Tempo, Jaeger, etc.
OTEL_SERVICE_NAME=ai-chief-of-staff
OTEL_EXPORTER_OTLP_ENDPOINT=
PUBLIC_BACKEND_URL=http://localhost:8000
PUBLIC_FRONTEND_URL=http://localhost:3000
